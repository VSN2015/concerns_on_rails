# Rails 6.1 on SQLite. Generated half of the CI matrix — see
# .github/workflows/ci.yml and gemfiles/shared.rb.
source "https://rubygems.org"

gem "actionpack", "~> 6.1.7"
gem "activerecord", "~> 6.1.7"
gem "activesupport", "~> 6.1.7"
# Dev/test only: the gem does not depend on railties, but the suite exercises
# ConcernsOnRails::Railtie directly.
gem "railties", "~> 6.1.7"
gem "sqlite3", "~> 1.4"
# concurrent-ruby 1.3.5 dropped its own `require "logger"`, which Active
# Support only started doing for itself in 7.1 — without this pin every Rails
# line below 7.1 dies at boot with
# `uninitialized constant ActiveSupport::LoggerThreadSafeLevel::Logger`.
gem "concurrent-ruby", "< 1.3.5"

eval_gemfile File.expand_path("shared.rb", __dir__)

gemspec path: ".."
