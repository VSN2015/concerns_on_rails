# Rails 6.1 on SQLite. Generated half of the CI matrix — see
# .github/workflows/ci.yml and gemfiles/shared.rb.
source "https://rubygems.org"

gem "actionpack", "~> 6.1.7"
gem "activerecord", "~> 6.1.7"
gem "activesupport", "~> 6.1.7"
# Dev/test only: the gem does not depend on railties, but the suite exercises
# ConcernsOnRails::Railtie directly.
gem "railties", "~> 6.1.7"
gem "sqlite3", "~> 1.4"
# concurrent-ruby 1.3.5 dropped its own `require "logger"`, which Active
# Support only started doing for itself in 7.1 — without this pin every Rails
# line below 7.1 dies at boot with
# `uninitialized constant ActiveSupport::LoggerThreadSafeLevel::Logger`.
gem "concurrent-ruby", "< 1.3.5"
# Ruby 3.4 moved base64/bigdecimal/drb/mutex_m out of the default gems, and
# Ruby 4.0 moved benchmark/logger. Rails 6.x requires them without declaring
# them (activesupport 7.0.10 is the line that declares this exact set), so on
# those Rubies `require "active_record"` raises
# `LoadError: cannot load such file -- mutex_m` (or `-- logger` on 4.0). A Rails
# 6.x app on Ruby 3.4+ has to list them in its own Gemfile the same way. Gated
# on the Ruby version so the 3.2/3.3 jobs keep testing the default gems.
if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.4")
  gem "base64"
  gem "bigdecimal"
  gem "drb"
  gem "mutex_m"
end
if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("4.0")
  gem "benchmark"
  gem "logger"
end

eval_gemfile File.expand_path("shared.rb", __dir__)

gemspec path: ".."
